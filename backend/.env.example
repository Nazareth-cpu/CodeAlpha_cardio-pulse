# CardioPulse FastAPI Backend Environment Configuration Template
# Duplicate this file to .env for local runtime configuration.
# Never commit real credentials or secrets to version control.

# Application Environment (development, staging, production)
ENVIRONMENT=development

# API Versioning Prefix
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Machine Learning Artifact Overrides (optional, defaults to project relative paths)
ML_MODEL_PATH=
ML_METADATA_PATH=
ML_DATASET_PATH=

# Firebase Authentication Configuration
# Provide either service account credentials file path or explicit parameters:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=
