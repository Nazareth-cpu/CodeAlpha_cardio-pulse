# CardioPulse Client Environment Configuration Example
# Public Web SDK variables prefixed with VITE_ are bundled into frontend assets.
# NEVER put service account private keys or backend secrets in this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend FastAPI base URL (leave empty for same-origin proxy or set local development URL)
VITE_API_BASE_URL=
